# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=
CLIENT_ID=
# Guild (server) ID for instant slash-command registration during development.
# Leave blank to register commands globally instead (takes up to an hour to propagate).
GUILD_ID=

# Your Discord user ID - who gets pinged.
OWNER_USER_ID=

# Optional: if set, alerts are posted in this channel with @OWNER_USER_ID mentioned.
# If left blank, the bot DMs OWNER_USER_ID directly instead.
NOTIFY_CHANNEL_ID=

# How often to check every watch, in minutes. Keep this reasonable (>=3) to avoid
# hammering retailer sites / getting your IP blocked.
POLL_INTERVAL_MINUTES=5

# Sent as the User-Agent header on every request. Please put a real contact
# so a store operator can reach you if your polling is causing them trouble.
USER_AGENT=PokemonRestockBot/1.0 (personal stock alert; contact: you@example.com)
